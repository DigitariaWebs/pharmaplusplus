datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model WaitlistEntry {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  phone     String?
  source    String   @default("landing-page")
  createdAt DateTime @default(now())
}

model ContactMessage {
  id           Int      @id @default(autoincrement())
  name         String
  email        String
  phone        String?
  organization String?
  message      String?
  context      String?
  createdAt    DateTime @default(now())
}


